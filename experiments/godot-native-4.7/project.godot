; Native Windows Forward+ research target; original art, no game-port claim.
config_version=5

[application]
config/name="Seamless Fight - Native Renderer Research"
run/main_scene="res://scenes/stage.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.windows="d3d12"
scaling_3d/mode=0
scaling_3d/scale=1.0
environment/defaults/default_clear_color=Color(0.047, 0.052, 0.066, 1)

[physics]
common/physics_ticks_per_second=60
