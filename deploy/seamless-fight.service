[Unit]
Description=Seamless Fight standalone duel server
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/seamless-fight/current
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=18080
EnvironmentFile=/etc/seamless-fight.env
ExecStart=/usr/bin/node /opt/seamless-fight/current/server.mjs
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
