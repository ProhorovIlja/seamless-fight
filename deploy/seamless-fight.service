[Unit]
Description=Seamless Fight duel server (Debian 13)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/seamless-fight/current
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=18080 DEBIAN_13_REQUIRED=1
EnvironmentFile=/etc/seamless-fight.env
ExecStartPre=/opt/seamless-fight/runtime/bin/node /opt/seamless-fight/current/scripts/validate-runtime.mjs
ExecStart=/opt/seamless-fight/runtime/bin/node /opt/seamless-fight/current/server.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
# Compete at lower priority than the existing BBSC/Caddy services.
# MemoryMax is the last-resort safety cap, not a verified capacity claim.
CPUAccounting=yes
CPUWeight=40
IOAccounting=yes
IOWeight=50
MemoryAccounting=yes
MemoryHigh=384M
MemoryMax=768M
TasksMax=96
LimitNOFILE=8192
OOMScoreAdjust=300
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
