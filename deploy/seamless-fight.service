[Unit]
Description=Seamless Fight duel server (Debian 13)
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/seamless-fight/current
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=18080 DEBIAN_13_REQUIRED=1
EnvironmentFile=/etc/seamless-fight.env
ExecStartPre=/opt/seamless-fight/runtime/bin/node /opt/seamless-fight/current/scripts/validate-runtime.mjs
ExecStart=/opt/seamless-fight/runtime/bin/node /opt/seamless-fight/current/server.mjs
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
